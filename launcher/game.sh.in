#!/bin/sh
# Generated by py2ports. Install this file alongside its game directory.
set -u
BASE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
GAME="$BASE/@ID@"
RUNTIME="$GAME/runtime/runtime.squashfs"
mkdir -p "$GAME/data" "$GAME/cache" || exit 1
exec >>"$GAME/log.txt" 2>&1
echo "py2ports launcher: $(date)"
[ "$(uname -m)" = aarch64 ] || { echo 'This runtime requires ARM64 Linux.'; exit 1; }
MOUNT=$(mktemp -d '/tmp/py2ports-@ID@.XXXXXX') || exit 1
mounted=0
child=
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$mounted" = 1 ]; then
        umount "$MOUNT" || { echo "Could not unmount $MOUNT"; exit 1; }
    fi
    rmdir "$MOUNT" 2>/dev/null || true
    echo "Game exited with code $status"
    exit "$status"
}
stop() {
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    exit 143
}
trap cleanup EXIT
trap stop HUP INT TERM
mount -t squashfs -o loop,ro "$RUNTIME" "$MOUNT" || exit 1
mounted=1
export PYTHONHOME="$MOUNT"
export PYTHONPATH="$MOUNT/lib/@PYTHONLIB@/site-packages:$MOUNT/lib/@PYTHONLIB@"
export LD_LIBRARY_PATH="$MOUNT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONPYCACHEPREFIX="$GAME/cache"
export PY2PORTS_DATA_DIR="$GAME/data"
@ENVIRONMENT@
cd "$GAME/game"/@WORKDIR@ || exit 1
"$MOUNT/bin/python" "$GAME/game"/@ENTRYPOINT@ &
child=$!
status=0
wait "$child" || status=$?
child=
exit "$status"
